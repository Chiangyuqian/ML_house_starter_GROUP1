# ========================================
# ML房價預測專案 - 環境設定
# ========================================

# Python 版本需求：3.12（含）以上
# Python 3.9 不支援本專案指定的 scikit-learn 1.8.0

# 檢查目前的 Python 版本：
# py --version

# 使用 Python 3.12 安裝套件：
# py -3.12 -m pip install -r requirements.txt

# 使用 Python 3.12 執行專案：
# py -3.12 make_demo_data.py
# py -3.12 train.py
# py -3.12 predict.py

# 僅供文件說明，程式不會自動讀取此變數
REQUIRED_PYTHON_VERSION=3.12
